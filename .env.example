# =============================================================================
# CV Builder — copy to `.env` locally or add in Vercel → Project → Settings → Environment Variables.
# Database and auth are always required.
# =============================================================================

# --- Required ---
# Local Docker: postgresql://postgres:password@localhost:5432/cv-builder
# Supabase (transaction-mode pooler, IPv4): replace [YOUR-PASSWORD]
DATABASE_URL="postgresql://postgres.gvcczvqzacajzuezqhha:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# Production: https://your-project.vercel.app  |  Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Email feature flag (default: off) ---
# When false, auth email hooks no-op (useful for local/dev without Postmark).
ENABLE_POSTMARK=false

# --- Required when ENABLE_POSTMARK=true ---
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=noreply@yourdomain.com

# --- Email confirmation feature flag (default: off) ---
# When true, users must verify email before sign-in (requires Postmark in practice).
ENABLE_EMAIL_CONFIRMATION=false

# --- Passkey sign-in feature flag (default: off) ---
# NEXT_PUBLIC_ is required so the login client UI can read the flag.
NEXT_PUBLIC_ENABLE_PASSKEY=false

# --- Optional: OAuth sign-in (omit both vars for a provider to disable it) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Optional: Stripe subscriptions ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- Optional: AI text improvement (Google Gemini) ---
# When unset (or AI_IMPROVE_MOCK=true), the app returns deterministic mock improvements.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_IMPROVE_MOCK=false

# --- MCP server (cover letter tool at /api/mcp) ---
# Required for MCP clients. Send as: Authorization: Bearer <MCP_API_KEY>
# Privileged secret: a valid key can load any CV by id.
MCP_API_KEY=

# --- Local Docker Postgres helpers (not used by the app directly) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=next_cv_builder
