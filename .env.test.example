# Copy to `.env.test` for local BDD runs.
# Use a dedicated test database (not production). Local Docker is optional.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
BETTER_AUTH_SECRET=test-better-auth-secret-at-least-32-chars
# Must match the Playwright webServer port (default BDD port 3001)
BETTER_AUTH_URL=http://localhost:3001

ENABLE_POSTMARK=false
ENABLE_EMAIL_CONFIRMATION=false
NEXT_PUBLIC_ENABLE_PASSKEY=false

DISABLE_AUTH_RATE_LIMIT=true

# Leave unset for BDD (avoids rate-limit flakes and external deps):
# ARCJET_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Optional local Docker Postgres (docker compose -f docker-compose.test.yml up -d):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cv_builder_test
